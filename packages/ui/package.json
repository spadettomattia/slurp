{
  "name": "@slurp-ui/react",
  "version": "1.0.0",
  "description": "Slurp UI: ready-made React components of the Slurp design system, with optional collapse/expand motion.",
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui",
    "slurp",
    "accessibility",
    "animation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spadettomattia/slurp.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/spadettomattia/slurp/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/spadettomattia/slurp/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "import": "./dist/motion/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node --disable-warning=ExperimentalWarning scripts/build-css.ts",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests",
    "check:pkg": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./tokens.css ./styles.css",
    "size": "size-limit",
    "clean": "rimraf dist .turbo"
  },
  "size-limit": [
    {
      "name": "Button + SlurpProvider",
      "path": "dist/index.js",
      "import": "{ Button, SlurpProvider }",
      "limit": "15 kB",
      "gzip": true
    },
    {
      "name": "@slurp-ui/react (everything)",
      "path": "dist/index.js",
      "limit": "40 kB",
      "gzip": true
    }
  ],
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@slurp-ui/icons": "workspace:^",
    "@slurp-ui/motion": "workspace:^",
    "@slurp-ui/tokens": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@slurp-ui/tsconfig": "workspace:*",
    "@slurp-ui/tsdown-config": "workspace:*",
    "@slurp-ui/utils": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "size-limit": "^14.2.0",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
