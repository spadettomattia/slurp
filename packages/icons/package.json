{
  "name": "@slurp-ui/icons",
  "version": "1.0.1",
  "description": "Slurp icons: inline stroke SVG (2px, round caps), currentColor, tree-shakable.",
  "keywords": [
    "icons",
    "svg",
    "react",
    "design-system",
    "slurp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spadettomattia/slurp.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/spadettomattia/slurp/tree/main/packages/icons#readme",
  "bugs": {
    "url": "https://github.com/spadettomattia/slurp/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@slurp-ui/tsconfig": "workspace:*",
    "@slurp-ui/tsdown-config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
