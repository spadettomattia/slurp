{
  "name": "@slurp-ui/motion",
  "version": "0.0.0",
  "description": "Slurp collapse/expand animation engine (vanilla TS) with optional React bindings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spadettomattia/slurp.git",
    "directory": "packages/motion"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "size": "size-limit",
    "clean": "rimraf dist .turbo"
  },
  "size-limit": [
    {
      "name": "@slurp-ui/motion",
      "path": "dist/index.js",
      "limit": "8 kB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@slurp-ui/tsconfig": "workspace:*",
    "@slurp-ui/tsdown-config": "workspace:*",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "size-limit": "^14.2.0",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
